generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillingStatus {
  demo
  active

  @@map("billing_status")
}

enum PaymentWorkflow {
  calendar_month
  rolling_30_days
  training_credits
  training_credits_30_days

  @@map("payment_workflow")
}

model Club {
  facebookPageConnection FacebookPageConnection?
  facebookConnectAttempts FacebookConnectAttempt[]
  id                      String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  sports                  String?
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  emblemUrl               String?                     @map("emblem_url")
  imagePublicId           String?                     @map("image_public_id")
  imageUrl                String?                     @map("image_url")
  reminderDay             Int                         @default(25) @map("reminder_day")
  overdueDay              Int                         @default(1) @map("overdue_day")
  reminderHour            Int                         @default(10) @map("reminder_hour")
  reminderMinute          Int                         @default(0) @map("reminder_minute")
  secondReminderDay       Int?                        @map("second_reminder_day")
  secondReminderHour      Int?                        @map("second_reminder_hour")
  secondReminderMinute    Int?                        @map("second_reminder_minute")
  thirdReminderDay        Int?                        @map("third_reminder_day")
  thirdReminderHour       Int?                        @map("third_reminder_hour")
  thirdReminderMinute     Int?                        @map("third_reminder_minute")
  overdueHour             Int                         @default(10) @map("overdue_hour")
  overdueMinute           Int                         @default(0) @map("overdue_minute")
  reminderTz              String                      @default("Europe/Sofia") @map("reminder_tz")
  trainingWeekdays        Int[]                       @default([]) @map("training_weekdays")
  trainingDates           String[]                    @default([]) @map("training_dates")
  trainingTime            String?                     @map("training_time")
  trainingDateTimes       Json?                       @map("training_date_times")
  trainingDurationMinutes Int                         @default(60) @map("training_duration_minutes")
  trainingFieldId         String?                     @map("training_field_id") @db.Uuid
  trainingFieldPieceIds   String[]                    @default([]) @map("training_field_piece_ids") @db.Uuid
  trainingFieldSelections Json?                       @map("training_field_selections")
  trainingWindowDays      Int                         @default(30) @map("training_window_days")
  playerFields            String[]                    @default([]) @map("player_fields")
  trainingGroupMode       String                      @default("custom_group") @map("training_group_mode")
  rulesDocumentUrl        String?                     @map("rules_document_url")
  rulesDocumentPublicId   String?                     @map("rules_document_public_id")
  rulesDocument           Bytes?                      @map("rules_document")
  rulesDocuments          ClubRulesDocument[]
  players                 Player[]
  adminPushSubscriptions  AdminPushSubscription[]
  adminNotifications      AdminNotification[]
  trainingNotes           TrainingNote[]
  trainingSessions        TrainingSession[]
  trainingGroupSchedules  ClubTrainingGroupSchedule[]
  trainingScheduleGroups  ClubTrainingScheduleGroup[]
  customTrainingGroups    ClubCustomTrainingGroup[]
  fields                  Field[]
  coachGroups             CoachGroup[]
  notifyOnCoachVisit      Boolean                     @default(false) @map("notify_on_coach_visit")
  platformSubscription    ClubSubscription?
  billingStatus           BillingStatus               @default(demo) @map("billing_status")
  paymentWorkflow         PaymentWorkflow             @default(calendar_month) @map("payment_workflow")
  firstBillingMonth       DateTime?                   @map("first_billing_month") @db.Timestamptz(6)
  billingActivatedAt      DateTime?                   @map("billing_activated_at") @db.Timestamptz(6)
  defaultPaymentAmount    Decimal                     @default(0) @map("default_payment_amount") @db.Decimal(10, 2)
  defaultOnlineTrainingCredits Int                    @default(0) @map("default_online_training_credits")
  irisPayments            IrisPayment[]
  discountConfigs         TeamDiscountConfig[]
  matches                    ClubMatch[]
  trainingPlans              TrainingPlan[]
  limitedTrainingEvents      LimitedTrainingEvent[]

  @@map("clubs")
}

model AdminPushSubscription {
  id           String      @id @default(uuid())
  clubId       String      @map("club_id") @db.Uuid
  endpoint     String
  p256dh       String
  auth         String
  userAgent    String?     @map("user_agent")
  device       String?
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  coachGroupId String?     @map("coach_group_id") @db.Uuid
  club         Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  coachGroup   CoachGroup? @relation(fields: [coachGroupId], references: [id], onDelete: SetNull)

  @@unique([clubId, endpoint])
  @@index([clubId, isActive])
  @@index([clubId, coachGroupId, isActive])
  @@map("admin_push_subscriptions")
}

model ClubTrainingGroupSchedule {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId                  String   @map("club_id") @db.Uuid
  teamGroup               Int      @map("team_group")
  trainingWeekdays        Int[]    @default([]) @map("training_weekdays")
  trainingDates           String[] @default([]) @map("training_dates")
  trainingTime            String?  @map("training_time")
  trainingDateTimes       Json?    @map("training_date_times")
  trainingDurationMinutes Int      @default(60) @map("training_duration_minutes")
  trainingFieldId         String?  @map("training_field_id") @db.Uuid
  trainingFieldPieceIds   String[] @default([]) @map("training_field_piece_ids") @db.Uuid
  trainingFieldSelections Json?    @map("training_field_selections")
  trainingWindowDays      Int      @default(30) @map("training_window_days")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  club                    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, teamGroup])
  @@index([clubId])
  @@map("club_training_group_schedules")
}

model ClubTrainingScheduleGroup {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId                  String   @map("club_id") @db.Uuid
  name                    String
  teamGroups              Int[]    @default([]) @map("team_groups")
  trainingWeekdays        Int[]    @default([]) @map("training_weekdays")
  trainingDates           String[] @default([]) @map("training_dates")
  trainingTime            String?  @map("training_time")
  trainingDateTimes       Json?    @map("training_date_times")
  trainingDurationMinutes Int      @default(60) @map("training_duration_minutes")
  trainingFieldId         String?  @map("training_field_id") @db.Uuid
  trainingFieldPieceIds   String[] @default([]) @map("training_field_piece_ids") @db.Uuid
  trainingFieldSelections Json?    @map("training_field_selections")
  trainingWindowDays      Int      @default(30) @map("training_window_days")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  club                    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("club_training_schedule_groups")
}

model ClubCustomTrainingGroup {
  id                      String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId                  String                          @map("club_id") @db.Uuid
  coachGroupId            String?                         @map("coach_group_id") @db.Uuid
  color                   String?                         @map("color")
  name                    String
  trainingWeekdays        Int[]                           @default([]) @map("training_weekdays")
  trainingDates           String[]                        @default([]) @map("training_dates")
  trainingTime            String?                         @map("training_time")
  trainingDateTimes       Json?                           @map("training_date_times")
  trainingDurationMinutes Int                             @default(60) @map("training_duration_minutes")
  trainingFieldId         String?                         @map("training_field_id") @db.Uuid
  trainingFieldPieceIds   String[]                        @default([]) @map("training_field_piece_ids") @db.Uuid
  trainingFieldSelections Json?                           @map("training_field_selections")
  trainingWindowDays      Int                             @default(30) @map("training_window_days")
  createdAt               DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  club                    Club                            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  coachGroup              CoachGroup?                     @relation(fields: [coachGroupId], references: [id], onDelete: Cascade)
  players                 ClubCustomTrainingGroupPlayer[]
  matches                 ClubMatch[]

  @@index([clubId])
  @@index([clubId, coachGroupId])
  @@map("club_custom_training_groups")
}

model CoachGroup {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId                  String                  @map("club_id") @db.Uuid
  name                    String
  trainingWeekdays        Int[]                   @default([]) @map("training_weekdays")
  trainingDates           String[]                @default([]) @map("training_dates")
  trainingTime            String?                 @map("training_time")
  trainingDateTimes       Json?                   @map("training_date_times")
  trainingDurationMinutes Int                     @default(60) @map("training_duration_minutes")
  trainingFieldId         String?                 @map("training_field_id") @db.Uuid
  trainingFieldPieceIds   String[]                @default([]) @map("training_field_piece_ids") @db.Uuid
  trainingFieldSelections Json?                   @map("training_field_selections")
  trainingWindowDays      Int                     @default(30) @map("training_window_days")
  trainingRecurrences     Json?                   @map("training_recurrences")
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  club                    Club                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  paymentAmount           Decimal?                @map("payment_amount") @db.Decimal(10, 2)
  billingPlayers          Player[]                @relation("PlayerBillingCoachGroup")
  players                 Player[]                @relation("PlayerCoachGroups")
  customTrainingGroups    ClubCustomTrainingGroup[]
  adminPushSubscriptions  AdminPushSubscription[]
  adminNotifications      AdminNotification[]

  @@index([clubId])
  @@map("coach_groups")
}

model Field {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId    String       @map("club_id") @db.Uuid
  name      String
  fieldType String       @default("football") @map("field_type")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  pieces    FieldPiece[]

  @@index([clubId])
  @@map("fields")
}

model FieldPiece {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@map("field_pieces")
}

model ClubRulesDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  name      String
  document  Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("club_rules_documents")
}

model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  password  String
  roles     UserRole[]
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Player {
  id                   String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId               String                          @map("club_id") @db.Uuid
  fullName             String                          @map("full_name")
  status               PlayerStatus                    @default(paid)
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  attendanceStartedAt  DateTime?                       @map("attendance_started_at") @db.Timestamptz(6)
  attendanceMemberships AttendanceMembership[]
  updatedAt            DateTime                        @default(now()) @map("updated_at") @db.Timestamptz(6)
  rank                 String?
  age                  Int?
  weight               Float?
  jerseyNumber         String?                         @map("jersey_number")
  parentPhone          String?                         @map("parent_phone")
  playerPhone          String?                         @map("player_phone")
  birthDate            DateTime?                       @map("birth_date") @db.Date
  teamGroup            Int?                            @map("team_group")
  lastPaymentDate      DateTime?                       @map("last_payment_date") @db.Timestamptz(6)
  isActive             Boolean                         @default(true) @map("is_active")
  coachNote            String?                         @map("coach_note")
  cards                Card[]
  images               Image[]
  paymentLogs          PaymentLog[]
  paymentWaivers       PaymentWaiver[]
  irisPayments          IrisPayment[]
  playerNotification   PlayerNotification[]
  adminNotifications   AdminNotification[]
  club                 Club                            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  pushSubscriptions    PushSubscription[]
  trainingOptOuts      TrainingOptOut[]
  matchAttendance      ClubMatchPlayer[]
  trainingSessionRows  TrainingSessionPlayer[]
  discountUsages       PartnerDiscountUsage[]
  customTrainingGroups ClubCustomTrainingGroupPlayer[]
  coachGroups                  CoachGroup[]                    @relation("PlayerCoachGroups")
  firstBillingMonth            DateTime?                       @map("first_billing_month") @db.Timestamptz(6)
  paymentAmount                Decimal                         @default(0) @map("payment_amount") @db.Decimal(10, 2)
  billingCoachGroupId          String?                         @map("billing_coach_group_id") @db.Uuid
  billingCoachGroup            CoachGroup?                     @relation("PlayerBillingCoachGroup", fields: [billingCoachGroupId], references: [id], onDelete: SetNull)
  remainingTrainingCredits     Int                             @default(0) @map("remaining_training_credits")
  limitedTrainingRegistrations LimitedTrainingRegistration[]

  @@index([billingCoachGroupId])
  @@index([clubId])
  @@map("players")
}

model AttendanceMembership {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId  String    @map("player_id") @db.Uuid
  scopeKey  String    @map("scope_key")
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(6)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(6)
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, scopeKey])
  @@map("attendance_memberships")
}

model ClubCustomTrainingGroupPlayer {
  groupId   String                  @map("group_id") @db.Uuid
  playerId  String                  @map("player_id") @db.Uuid
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  group     ClubCustomTrainingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player    Player                  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([groupId, playerId])
  @@index([groupId])
  @@index([playerId])
  @@map("club_custom_training_group_players")
}

model TrainingOptOut {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId     String   @map("player_id") @db.Uuid
  trainingDate DateTime @map("training_date") @db.Date
  reasonCode   String?  @map("reason_code")
  reasonText   String?  @map("reason_text")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, trainingDate])
  @@index([trainingDate])
  @@map("training_opt_outs")
}

model TrainingNote {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId          String   @map("club_id") @db.Uuid
  trainingDate    DateTime @map("training_date") @db.Date
  scopeKey        String   @default("club") @map("scope_key")
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, trainingDate, scopeKey])
  @@index([trainingDate])
  @@map("training_notes")
}

model TrainingSession {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId                  String   @map("club_id") @db.Uuid
  scopeType               String   @map("scope_type")
  scopeKey                String   @map("scope_key")
  scopeId                 String?  @map("scope_id") @db.Uuid
  teamGroup               Int?     @map("team_group")
  teamGroups              Int[]    @default([]) @map("team_groups")
  trainingDate            DateTime @map("training_date") @db.Date
  trainingTime            String?  @map("training_time")
  trainingDurationMinutes Int      @default(60) @map("training_duration_minutes")
  trainingFieldId         String?  @map("training_field_id") @db.Uuid
  trainingFieldPieceIds   String[] @default([]) @map("training_field_piece_ids") @db.Uuid
  status                  String   @default("scheduled")
  removedFromSchedule     Boolean  @default(false) @map("removed_from_schedule")
  rosterLockedAt          DateTime? @map("roster_locked_at") @db.Timestamptz(6)
  occurrenceKey           String   @default("") @map("occurrence_key")
  recurrenceId            String?  @map("recurrence_id") @db.Uuid
  recurrenceDate          DateTime? @map("recurrence_date") @db.Date
  note                    String?
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  club                    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  players                 TrainingSessionPlayer[]

  @@unique([clubId, scopeKey, trainingDate, occurrenceKey], name: "clubId_scopeKey_trainingDate", map: "training_sessions_scope_date_occurrence_key")
  @@index([clubId, trainingDate])
  @@index([clubId, scopeKey, trainingDate])
  @@map("training_sessions")
}

model TrainingSessionPlayer {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trainingSessionId String          @map("training_session_id") @db.Uuid
  playerId          String?         @map("player_id") @db.Uuid
  playerName        String          @map("player_name")
  teamGroup         Int?            @map("team_group")
  present           Boolean         @default(true)
  attendanceRecorded Boolean        @default(false) @map("attendance_recorded")
  creditChargedAt   DateTime?        @map("credit_charged_at") @db.Timestamptz(6)
  reasonCode        String?         @map("reason_code")
  reasonText        String?         @map("reason_text")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  player            Player?         @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([trainingSessionId, playerId])
  @@index([playerId])
  @@index([trainingSessionId])
  @@map("training_session_players")
}

model ClubMatch {
  description String @default("")
  category String?
  eventType String @default("match") @map("event_type")
  homeScore Int? @map("home_score")
  awayScore Int? @map("away_score")
  attendanceEnabled Boolean @default(false) @map("attendance_enabled")
  players ClubMatchPlayer[]
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId          String                   @map("club_id") @db.Uuid
  customGroupId   String?                  @map("custom_group_id") @db.Uuid
  opponent        String
  location        String
  matchDate       String                   @map("match_date")
  matchTime       String                   @map("match_time")
  durationMinutes Int                      @default(90) @map("duration_minutes")
  isHome          Boolean                  @default(true) @map("is_home")
  teamGroups      Int[]                    @default([]) @map("team_groups")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  club            Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  customGroup     ClubCustomTrainingGroup? @relation(fields: [customGroupId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([matchDate])
  @@index([customGroupId])
  @@map("club_matches")
}

model TrainingPlan {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId          String   @map("club_id") @db.Uuid
  title           String
  description     String?
  layout          Json
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("training_plans")
}

model Image {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId    String  @map("player_id") @db.Uuid
  imageUrl    String  @map("image_url")
  isAdminView Boolean @map("is_admin_view")
  player      Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("images")
}

model PaymentLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId   String   @map("player_id") @db.Uuid
  paidAt     DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  recordedBy String   @default("admin") @map("recorded_by")
  paidFor    DateTime @map("paid_for") @db.Timestamptz(6)
  amount     Decimal? @db.Decimal(10, 2)
  currency   String   @default("EUR")
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  irisPayment IrisPayment?

  @@index([playerId])
  @@map("payment_logs")
}

enum IrisPaymentStatus {
  WAITING
  FAILED
  CONFIRMED

  @@map("iris_payment_status")
}

model IrisPayment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId           String            @map("club_id") @db.Uuid
  playerId         String            @map("player_id") @db.Uuid
  paymentHash      String?           @unique @map("payment_hash")
  accountId        String?           @map("account_id")
  paymentLink      String?           @map("payment_link")
  shortPaymentLink String?           @map("short_payment_link")
  orderId          String            @unique @map("order_id")
  amount           Decimal           @db.Decimal(10, 2)
  currency         String            @default("EUR")
  paidFor          DateTime          @map("paid_for") @db.Timestamptz(6)
  paidThrough      DateTime?         @map("paid_through") @db.Timestamptz(6)
  quotedPaidDates  Json?             @map("quoted_paid_dates")
  trainingCredits  Int?              @map("training_credits")
  status           IrisPaymentStatus @default(WAITING)
  paymentLogId     String?           @unique @map("payment_log_id") @db.Uuid
  rawCreatePayload Json?             @map("raw_create_payload")
  rawStatusPayload Json?             @map("raw_status_payload")
  rawWebhookPayload Json?            @map("raw_webhook_payload")
  confirmedAt      DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  linkDeactivatedAt    DateTime?     @map("link_deactivated_at") @db.Timestamptz(6)
  linkDeactivationError String?      @map("link_deactivation_error")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  club       Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player     Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  paymentLog PaymentLog? @relation(fields: [paymentLogId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([playerId])
  @@index([status])
  @@map("iris_payments")
}

model PaymentWaiver {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  waivedFor DateTime @map("waived_for") @db.Timestamptz(6)
  reason    String?
  createdBy String   @default("admin") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, waivedFor])
  @@index([playerId])
  @@map("payment_waivers")
}

model PushSubscription {
  id        String   @id @default(uuid())
  playerId  String   @db.Uuid
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  device    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, endpoint])
  @@index([playerId, isActive])
  @@map("push_subscriptions")
}

model PlayerNotification {
  id       String    @id @default(uuid())
  playerId String    @db.Uuid
  type     String
  title    String
  body     String
  url      String?
  sentAt   DateTime  @default(now())
  readAt   DateTime?
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, sentAt])
  @@index([playerId, readAt])
  @@map("player_notifications")
}

model AdminNotification {
  imageUrl String? @map("image_url")
  imagePublicId String? @map("image_public_id")
  id           String      @id @default(uuid())
  clubId       String      @map("club_id") @db.Uuid
  playerId     String?     @map("player_id") @db.Uuid
  coachGroupId String?     @map("coach_group_id") @db.Uuid
  type         String
  title        String
  body         String
  url          String?
  sentAt       DateTime    @default(now()) @map("sent_at")
  readAt       DateTime?   @map("read_at")
  club         Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player       Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)
  coachGroup   CoachGroup? @relation(fields: [coachGroupId], references: [id], onDelete: SetNull)

  @@index([clubId, sentAt])
  @@index([clubId, readAt])
  @@index([clubId, playerId])
  @@index([clubId, coachGroupId, readAt])
  @@map("admin_notifications")
}

model Card {
  id        String   @id @default(uuid())
  cardCode  String   @unique
  playerId  String   @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id])

  @@index([playerId])
  @@map("cards")
}

model CronJobRun {
  id           BigInt    @id @default(autoincrement())
  jobName      String    @map("job_name")
  runYear      Int       @map("run_year")
  runMonth     Int       @map("run_month")
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  failedAt     DateTime? @map("failed_at") @db.Timestamptz(6)
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([jobName, runYear, runMonth])
  @@map("cron_job_runs")
}

model PartnerDiscountUsage {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  partner   String
  action    String
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([date])
  @@index([partner, date])
  @@map("partner_discount_usage")
}

model PageClick {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action    String   @default("unknown")
  clickedAt DateTime @default(now()) @map("clicked_at") @db.Timestamptz(6)

  @@index([clickedAt])
  @@index([action])
